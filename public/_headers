# Assets com HASH no nome (Expo web export) — imutáveis, cache longo.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Modelos 3D (GLB) do Studio. A vitrine roda em loja.getaura.com.br e o
# viewer (three.js) busca o arquivo por XHR em app.getaura.com.br: sem CORS
# o navegador recusa e a peça não aparece. Sem hash no nome: cache de um
# dia, para uma troca de modelo chegar às lojas sem esperar um ano.
/models/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Demais respostas (HTML/entry da SPA, JSON, etc.) — sempre revalidar para
# não servir um index.html antigo apontando p/ chunks de build anterior.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=0, must-revalidate

# 24/10/2026: imagens dos e-mails (logo e assinatura), por URL fixa e
# versionada: https://app.getaura.com.br/email/<nome>-v1.png. Trocar a
# imagem = arquivo novo (-v2), nunca sobrescrever, então o cache é longo.
# O "! Cache-Control" tira o max-age=0 do /* acima: sem ele o Cloudflare
# junta os dois valores na mesma linha (medido em 24/10 no /_expo/* e no
# /models/*: "public, max-age=0, must-revalidate, public, max-age=...").
/email/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Painel fora da busca (06/10/2026). So o host do painel: a regra com host
# absoluto nao pega loja.getaura.com.br nem outro dominio que venha a
# apontar para este Worker. Vale tambem para o fallback de SPA (/login,
# /register...), que e asset como o index.html. Junto com a meta robots
# do index.html; o robots.txt libera o rastreio para o noindex ser lido.
https://app.getaura.com.br/*
  X-Robots-Tag: noindex, nofollow
  # 21/10/2026: depois de uma visita por https, o navegador passa a trocar
  # http:// por https:// sozinho, antes de pedir a página (um cliente abriu
  # o painel sem https e o login falhava por CORS). Só este host, sem
  # includeSubDomains: loja.getaura.com.br e os outros não passam por aqui.
  Strict-Transport-Security: max-age=31536000
